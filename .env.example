N8N_PORT=5678
GENERIC_TIMEZONE=Africa/Lagos
TZ=Africa/Lagos

N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
N8N_RUNNERS_AUTH_TOKEN=replace-with-a-long-random-string

N8N_SECURE_COOKIE=false

EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336

N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=true
N8N_PERSONALIZATION_ENABLED=false

WEBHOOK_URL=https://your-public-https-url.example.com/
N8N_EDITOR_BASE_URL=https://your-public-https-url.example.com/
N8N_PROXY_HOPS=1
